# ==========================================
# CyberKavach AI Environment Configuration
# ==========================================

# Django Backend
DJANGO_SECRET_KEY=
DEBUG=True
ALLOW_PUBLIC_REGISTRATION=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com,.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=False

# Database Configuration
# Local Development (leave empty to use default SQLite):
# DATABASE_URL=sqlite:///d:/Development/CyberKavachAI/backend/db.sqlite3
# Production Supabase / Neon PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require

# Frontend API Endpoint
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEV_BYPASS_AUTH=false
